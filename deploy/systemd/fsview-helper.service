[Unit]
Description=FSView root helper (typed disk operations over a Unix socket)
Documentation=https://github.com/krifmaz/fsview
After=local-fs.target systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/fsview helper --config /etc/fsview/helper.conf
Restart=on-failure
RestartSec=2
# /run/fsview holds the socket (root:fsview 0660).
RuntimeDirectory=fsview
RuntimeDirectoryMode=0755
UMask=0027
# No PrivateTmp/ProtectHome/ProtectKernelModules/ProtectSystem and similar:
# they give the service its own mount namespace, so the helper would see
# (and mount into) a private copy of the mount table instead of the host's.
# Isolation comes from the socket peer check and the fixed operation set.
NoNewPrivileges=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
